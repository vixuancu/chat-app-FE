# Ignore node_modules
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore build output
dist
dist-ssr
*.local

# Ignore IDE files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Ignore env files
.env
.env.local
.env.*.local

# Ignore documentation (already in image)
*.md
!README.md

# Ignore git
.git
.gitignore
.gitattributes

# Ignore test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Ignore config not needed in production
vite.config.ts.timestamp-*
tsconfig.tsbuildinfo
