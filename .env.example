# Environment Configuration
# Copy this file to .env and configure for your environment

# API Configuration (Backend runs on port 8081)
VITE_API_BASE_URL=http://localhost:8081/api/v1
VITE_WS_BASE_URL=ws://localhost:8081/api/v1/chat/ws

# Development Server (Frontend)
VITE_PORT=3000
VITE_HOST=0.0.0.0

# Backend Proxy (for development - proxy /api to backend)
VITE_BACKEND_API_URL=http://localhost:8081
VITE_BACKEND_WS_URL=ws://localhost:8081
